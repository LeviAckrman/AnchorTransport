rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------------------
    // 1. GLOBAL SAFETY NET - Default Deny
    // ------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------------
    // 2. GLOBAL PRIMITIVE & STRICT OWNER-ONLY TENANT ISOLATION HELPERS
    // ------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && ('email_verified' in request.auth.token)
        && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOptString(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }

    function isReqString(data, field, maxLen) {
      return (field in data) && data[field] is string && data[field].size() > 0 && data[field].size() <= maxLen;
    }

    function isOptNumber(data, field) {
      return !(field in data) || data[field] == null || data[field] is int || data[field] is float;
    }

    function isReqNumber(data, field) {
      return (field in data) && (data[field] is int || data[field] is float);
    }

    function isOptBool(data, field) {
      return !(field in data) || data[field] == null || data[field] is bool;
    }

    function companyDocPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId);
    }

    // Strict Owner-Only Authorization: validated exclusively by Firebase Auth UID == company.ownerId
    function isCompanyOwner(companyId) {
      return isSignedIn()
        && exists(companyDocPath(companyId))
        && get(companyDocPath(companyId)).data.ownerId == request.auth.uid;
    }

    function isVerifiedCompanyOwner(companyId) {
      return isVerifiedUser() && isCompanyOwner(companyId);
    }

    function isCreatedAtPreservedOrMigrated() {
      return ('createdAt' in existing() && existing().createdAt is timestamp)
        ? incoming().createdAt == existing().createdAt
        : incoming().createdAt == request.time;
    }

    function canMigrateLegacyCreatedAt() {
      return !('createdAt' in existing()) || !(existing().createdAt is timestamp);
    }

    // ------------------------------------------------------------------------
    // 3. VALIDATION BLUEPRINTS (Anti-Update-Gap & Anti-Shadow-Field)
    // ------------------------------------------------------------------------
    function isValidUser(data, userId) {
      return data.keys().hasAll(['id', 'email', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'email', 'name', 'phone', 'defaultCompanyId',
          'activeCompanyId', 'role', 'photoUrl', 'onboardingCompleted',
          'onboardingCompletedAt', 'createdAt', 'updatedAt'
        ])
        && data.id == userId
        && isReqString(data, 'email', 200)
        && isReqString(data, 'name', 100)
        && isOptString(data, 'phone', 20)
        && isOptString(data, 'defaultCompanyId', 128)
        && isOptString(data, 'activeCompanyId', 128)
        && (!('role' in data) || data.role == null || (data.role is string && data.role in ['USER', 'OWNER']))
        && isOptString(data, 'photoUrl', 1500)
        && isOptBool(data, 'onboardingCompleted')
        && isOptString(data, 'onboardingCompletedAt', 40)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidCompany(data, companyId) {
      return data.keys().hasAll(['id', 'name', 'ownerId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'name', 'tradeName', 'gstin', 'pan', 'phone', 'email', 'address',
          'city', 'state', 'stateCode', 'pincode', 'bankName', 'accountNumber',
          'ifscCode', 'branch', 'lrPrefix', 'invoicePrefix', 'tripPrefix',
          'fleetSize', 'logoUrl', 'ownerId', 'createdAt', 'updatedAt'
        ])
        && data.id == companyId
        && isReqString(data, 'name', 150)
        && isReqString(data, 'ownerId', 128)
        && isOptString(data, 'tradeName', 150)
        && isOptString(data, 'gstin', 15)
        && isOptString(data, 'pan', 10)
        && isOptString(data, 'phone', 25)
        && isOptString(data, 'email', 200)
        && isOptString(data, 'address', 300)
        && isOptString(data, 'city', 80)
        && isOptString(data, 'state', 60)
        && isOptString(data, 'stateCode', 5)
        && isOptString(data, 'pincode', 10)
        && isOptString(data, 'bankName', 100)
        && isOptString(data, 'accountNumber', 40)
        && isOptString(data, 'ifscCode', 15)
        && isOptString(data, 'branch', 100)
        && isOptString(data, 'lrPrefix', 30)
        && isOptString(data, 'invoicePrefix', 30)
        && isOptString(data, 'tripPrefix', 30)
        && isOptString(data, 'fleetSize', 50)
        && isOptString(data, 'logoUrl', 1500)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidMember(data, companyId, memberUid) {
      return data.keys().hasAll(['id', 'userId', 'companyId', 'role', 'email', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'userId', 'companyId', 'role', 'name', 'email', 'status',
          'invitedByUid', 'joinedAt', 'createdAt', 'updatedAt'
        ])
        && data.id == memberUid
        && data.userId == memberUid
        && data.companyId == companyId
        && data.role == 'OWNER'
        && isOptString(data, 'name', 100)
        && isReqString(data, 'email', 200)
        && data.status == 'ACTIVE'
        && isOptString(data, 'invitedByUid', 128)
        && isOptString(data, 'joinedAt', 40)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidVehicle(data, companyId, vehicleId) {
      return data.keys().hasAll(['id', 'companyId', 'registrationNumber', 'vehicleType', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'registrationNumber', 'vehicleType', 'makeModel',
          'capacityTonnes', 'unladenWeightTonnes', 'chassisNumber', 'engineNumber',
          'status', 'currentOdometerKm', 'fastagBalancePaise', 'assignedDriverId',
          'assignedDriverName', 'activeTripId', 'insuranceExpiry', 'insurancePolicyNumber',
          'fitnessExpiry', 'fitnessCertificateNumber', 'permitExpiry', 'permitNumber',
          'permitType', 'pucExpiry', 'pucNumber', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.id == vehicleId
        && data.companyId == companyId
        && isReqString(data, 'registrationNumber', 30)
        && isReqString(data, 'vehicleType', 60)
        && isOptString(data, 'makeModel', 100)
        && isOptNumber(data, 'capacityTonnes')
        && isOptNumber(data, 'unladenWeightTonnes')
        && isOptString(data, 'chassisNumber', 60)
        && isOptString(data, 'engineNumber', 60)
        && data.status is string
        && data.status in ['AVAILABLE', 'IN_TRANSIT', 'UNDER_MAINTENANCE', 'INACTIVE']
        && isOptNumber(data, 'currentOdometerKm')
        && isOptNumber(data, 'fastagBalancePaise')
        && isOptString(data, 'assignedDriverId', 128)
        && isOptString(data, 'assignedDriverName', 100)
        && isOptString(data, 'activeTripId', 128)
        && isOptString(data, 'insuranceExpiry', 30)
        && isOptString(data, 'insurancePolicyNumber', 60)
        && isOptString(data, 'fitnessExpiry', 30)
        && isOptString(data, 'fitnessCertificateNumber', 60)
        && isOptString(data, 'permitExpiry', 30)
        && isOptString(data, 'permitNumber', 60)
        && (!('permitType' in data) || data.permitType == null || (data.permitType is string && data.permitType in ['NATIONAL', 'STATE']))
        && isOptString(data, 'pucExpiry', 30)
        && isOptString(data, 'pucNumber', 60)
        && isOptString(data, 'notes', 500)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidDriver(data, companyId, driverId) {
      return data.keys().hasAll(['id', 'companyId', 'fullName', 'phone', 'licenseNumber', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'fullName', 'phone', 'altPhone', 'licenseNumber',
          'licenseExpiry', 'badgeNumber', 'address', 'emergencyContact', 'emergencyPhone',
          'status', 'currentAdvanceBalancePaise', 'totalTripsCompleted', 'monthlySalaryPaise',
          'perDayBataPaise', 'assignedVehicleId', 'assignedVehicleReg', 'aadharNumber',
          'panNumber', 'bankAccount', 'bankIfsc', 'bankName', 'bankBranch',
          'isSensitiveDataRedacted', 'joinedDate', 'createdAt', 'updatedAt'
        ])
        && data.id == driverId
        && data.companyId == companyId
        && isReqString(data, 'fullName', 100)
        && isReqString(data, 'phone', 20)
        && isOptString(data, 'altPhone', 20)
        && isReqString(data, 'licenseNumber', 40)
        && isOptString(data, 'licenseExpiry', 30)
        && isOptString(data, 'badgeNumber', 40)
        && isOptString(data, 'address', 250)
        && isOptString(data, 'emergencyContact', 100)
        && isOptString(data, 'emergencyPhone', 20)
        && data.status is string
        && data.status in ['AVAILABLE', 'ON_TRIP', 'ON_LEAVE', 'INACTIVE']
        && isOptNumber(data, 'currentAdvanceBalancePaise')
        && isOptNumber(data, 'totalTripsCompleted')
        && isOptNumber(data, 'monthlySalaryPaise')
        && isOptNumber(data, 'perDayBataPaise')
        && isOptString(data, 'assignedVehicleId', 128)
        && isOptString(data, 'assignedVehicleReg', 30)
        && isOptString(data, 'aadharNumber', 25)
        && isOptString(data, 'panNumber', 15)
        && isOptString(data, 'bankAccount', 40)
        && isOptString(data, 'bankIfsc', 15)
        && isOptString(data, 'bankName', 80)
        && isOptString(data, 'bankBranch', 80)
        && isOptBool(data, 'isSensitiveDataRedacted')
        && isOptString(data, 'joinedDate', 30)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidCustomer(data, companyId, customerId) {
      return data.keys().hasAll(['id', 'companyId', 'name', 'phone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'name', 'tradeName', 'gstin', 'pan', 'contactPerson',
          'phone', 'email', 'billingAddress', 'city', 'state', 'stateCode', 'pincode',
          'creditPeriodDays', 'paymentTermsDays', 'creditLimitPaise',
          'currentOutstandingPaise', 'totalFreightBilledPaise', 'notes', 'status',
          'createdAt', 'updatedAt'
        ])
        && data.id == customerId
        && data.companyId == companyId
        && isReqString(data, 'name', 150)
        && isOptString(data, 'tradeName', 150)
        && isOptString(data, 'gstin', 20)
        && isOptString(data, 'pan', 15)
        && isOptString(data, 'contactPerson', 100)
        && isReqString(data, 'phone', 20)
        && isOptString(data, 'email', 200)
        && isOptString(data, 'billingAddress', 300)
        && isOptString(data, 'city', 80)
        && isOptString(data, 'state', 60)
        && isOptString(data, 'stateCode', 5)
        && isOptString(data, 'pincode', 10)
        && isOptNumber(data, 'creditPeriodDays')
        && isOptNumber(data, 'paymentTermsDays')
        && isOptNumber(data, 'creditLimitPaise')
        && isOptNumber(data, 'currentOutstandingPaise')
        && isOptNumber(data, 'totalFreightBilledPaise')
        && isOptString(data, 'notes', 500)
        && (!('status' in data) || data.status == null || (data.status is string && data.status in ['ACTIVE', 'INACTIVE', 'BLOCKED']))
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidBroker(data, companyId, brokerId) {
      return data.keys().hasAll(['id', 'companyId', 'name', 'phone', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'name', 'companyName', 'phone', 'email', 'gstin', 'pan',
          'city', 'state', 'commissionRatePercent', 'defaultCommissionPaise',
          'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && data.id == brokerId
        && data.companyId == companyId
        && isReqString(data, 'name', 150)
        && isOptString(data, 'companyName', 150)
        && isReqString(data, 'phone', 20)
        && isOptString(data, 'email', 200)
        && isOptString(data, 'gstin', 20)
        && isOptString(data, 'pan', 15)
        && isOptString(data, 'city', 80)
        && isOptString(data, 'state', 60)
        && isOptNumber(data, 'commissionRatePercent')
        && isOptNumber(data, 'defaultCommissionPaise')
        && isOptString(data, 'notes', 500)
        && (!('status' in data) || data.status == null || (data.status is string && data.status in ['ACTIVE', 'INACTIVE', 'BLOCKED']))
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    // Trips & Dispatch use direct Verified Company Owner authorization
    // without restrictive schema, timestamp, or field-allowlist checks.

    function isValidTripLog(data, companyId, tripId, logId) {
      return data.keys().hasAll([
          'id', 'companyId', 'tripId', 'status', 'timestamp', 'locationNote', 'createdAt', 'updatedAt'
        ])
        && data.id == logId
        && data.companyId == companyId
        && data.tripId == tripId
        && isOptString(data, 'tripNumber', 120)
        && isReqString(data, 'status', 120)
        && (!('severity' in data) || data.severity == null || (data.severity is string && data.severity in ['INFO', 'SUCCESS', 'WARNING', 'CRITICAL']))
        && isReqString(data, 'timestamp', 60)
        && isReqString(data, 'locationNote', 500)
        && (!('latitude' in data) || data.latitude == null || ((data.latitude is int || data.latitude is float) && data.latitude >= -90 && data.latitude <= 90))
        && (!('longitude' in data) || data.longitude == null || ((data.longitude is int || data.longitude is float) && data.longitude >= -180 && data.longitude <= 180))
        && (!('odometerKm' in data) || data.odometerKm == null || ((data.odometerKm is int || data.odometerKm is float) && data.odometerKm >= 0))
        && isOptString(data, 'notes', 1000)
        && isOptString(data, 'loggedByUid', 128)
        && isOptString(data, 'loggedByName', 150)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidExpense(data, companyId, expenseId) {
      return data.keys().hasAll(['id', 'companyId', 'category', 'amountPaise', 'paymentMode', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'tripId', 'tripNumber', 'vehicleId', 'vehicleReg',
          'driverId', 'driverName', 'category', 'amountPaise', 'paymentMode',
          'date', 'expenseDate', 'description', 'litres', 'litresFuel', 'ratePerLitrePaise',
          'pumpName', 'petrolPumpName', 'location', 'odometerReading', 'receiptNumber',
          'voucherNumber', 'receiptUrl', 'receiptAttachmentUrl', 'notes', 'recordedBy',
          'createdBy', 'isDriverDisbursed', 'isSettled', 'settlementId', 'createdAt', 'updatedAt'
        ])
        && data.id == expenseId
        && data.companyId == companyId
        && isOptString(data, 'tripId', 128)
        && isOptString(data, 'tripNumber', 50)
        && isOptString(data, 'vehicleId', 128)
        && isOptString(data, 'vehicleReg', 30)
        && isOptString(data, 'driverId', 128)
        && isOptString(data, 'driverName', 100)
        && data.category is string
        && data.category in [
          'FUEL', 'DIESEL', 'TOLL', 'TOLL_FASTAG', 'PARKING', 'DRIVER_ALLOWANCE',
          'DRIVER_BATA', 'LOADING', 'UNLOADING', 'LOADING_UNLOADING', 'REPAIR',
          'EN_ROUTE_REPAIR', 'TYRE_PUNCTURE', 'DEF_ADBLUE', 'RTO_POLICE', 'WEIGHBRIDGE', 'OTHER'
        ]
        && isReqNumber(data, 'amountPaise') && data.amountPaise > 0
        && data.paymentMode is string
        && data.paymentMode in ['CASH', 'FASTAG', 'PETRO_CARD', 'UPI', 'DRIVER_POCKET', 'BANK_TRANSFER']
        && isOptString(data, 'date', 40)
        && isOptString(data, 'expenseDate', 40)
        && isOptString(data, 'description', 300)
        && isOptNumber(data, 'litres')
        && isOptNumber(data, 'litresFuel')
        && isOptNumber(data, 'ratePerLitrePaise')
        && isOptString(data, 'pumpName', 120)
        && isOptString(data, 'petrolPumpName', 120)
        && isOptString(data, 'location', 120)
        && isOptNumber(data, 'odometerReading')
        && isOptString(data, 'receiptNumber', 60)
        && isOptString(data, 'voucherNumber', 60)
        && isOptString(data, 'receiptUrl', 1500)
        && isOptString(data, 'receiptAttachmentUrl', 1500)
        && isOptString(data, 'notes', 400)
        && isOptString(data, 'recordedBy', 100)
        && isOptString(data, 'createdBy', 100)
        && isOptBool(data, 'isDriverDisbursed')
        && isOptBool(data, 'isSettled')
        && isOptString(data, 'settlementId', 128)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidAdvance(data, companyId, advanceId) {
      return data.keys().hasAll(['id', 'companyId', 'driverId', 'amountPaise', 'advanceType', 'date', 'isSettled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'tripId', 'tripNumber', 'driverId', 'driverName',
          'vehicleReg', 'amountPaise', 'advanceType', 'paymentMode', 'date',
          'reference', 'referenceNotes', 'notes', 'disbursedBy',
          'status', 'cancelledAt', 'cancellationReason', 'cancelledBy',
          'isSettled', 'settlementId', 'createdAt', 'updatedAt'
        ])
        && data.id == advanceId
        && data.companyId == companyId
        && isOptString(data, 'tripId', 128)
        && isOptString(data, 'tripNumber', 50)
        && isReqString(data, 'driverId', 128)
        && isOptString(data, 'driverName', 100)
        && isOptString(data, 'vehicleReg', 30)
        && isReqNumber(data, 'amountPaise') && data.amountPaise > 0
        && data.advanceType is string
        && data.advanceType in ['CASH_DISPATCH', 'CASH_EN_ROUTE', 'PUMP_DIESEL_SLIP', 'UPI_ONLINE', 'BANK_TRANSFER']
        && isOptString(data, 'paymentMode', 30)
        && isReqString(data, 'date', 40)
        && isOptString(data, 'reference', 100)
        && isOptString(data, 'referenceNotes', 300)
        && isOptString(data, 'notes', 300)
        && isOptString(data, 'disbursedBy', 100)
        && (!('status' in data) || data.status == null || (data.status is string && data.status in ['ACTIVE', 'CANCELLED', 'SETTLED']))
        && isOptString(data, 'cancelledAt', 40)
        && isOptString(data, 'cancellationReason', 300)
        && isOptString(data, 'cancelledBy', 100)
        && data.isSettled is bool
        && isOptString(data, 'settlementId', 128)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidSettlement(data, companyId, settlementId) {
      return data.keys().hasAll(['id', 'companyId', 'tripId', 'driverId', 'status', 'settledDate', 'netPayableToDriverPaise', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'tripId', 'tripNumber', 'driverId', 'driverName',
          'vehicleId', 'vehicleReg', 'settlementNumber',
          'totalRevenuePaise', 'fuelExpensesPaise', 'tollExpensesPaise',
          'otherExpensesPaise', 'totalExpensesPaise', 'tripProfitLossPaise',
          'totalAdvanceGivenPaise', 'driverCashExpensesPaise', 'driverBataAllowancePaise',
          'approvedDeductionsPaise', 'otherDeductionsPaise', 'deductionReason',
          'remainingDriverBalancePaise', 'netPayableToDriverPaise', 'isCompanyDue',
          'status', 'settledDate', 'settledBy', 'approvedBy', 'approvedAt',
          'settlementNotes', 'isCorrectionAuthorized', 'correctionReason', 'correctedBy',
          'correctedAt', 'createdAt', 'updatedAt'
        ])
        && data.id == settlementId
        && data.companyId == companyId
        && isReqString(data, 'tripId', 128)
        && isOptString(data, 'tripNumber', 50)
        && isReqString(data, 'driverId', 128)
        && isOptString(data, 'driverName', 100)
        && isOptString(data, 'vehicleId', 128)
        && isOptString(data, 'vehicleReg', 30)
        && isOptString(data, 'settlementNumber', 50)
        && isOptNumber(data, 'totalRevenuePaise')
        && isOptNumber(data, 'fuelExpensesPaise')
        && isOptNumber(data, 'tollExpensesPaise')
        && isOptNumber(data, 'otherExpensesPaise')
        && isOptNumber(data, 'totalExpensesPaise')
        && isOptNumber(data, 'tripProfitLossPaise')
        && isOptNumber(data, 'totalAdvanceGivenPaise')
        && isOptNumber(data, 'driverCashExpensesPaise')
        && isOptNumber(data, 'driverBataAllowancePaise')
        && isOptNumber(data, 'approvedDeductionsPaise')
        && isOptNumber(data, 'otherDeductionsPaise')
        && isOptString(data, 'deductionReason', 300)
        && isOptNumber(data, 'remainingDriverBalancePaise')
        && isReqNumber(data, 'netPayableToDriverPaise')
        && isOptBool(data, 'isCompanyDue')
        && data.status is string
        && data.status in ['DRAFT', 'PENDING_APPROVAL', 'APPROVED_SETTLED', 'FINALIZED']
        && isReqString(data, 'settledDate', 40)
        && isOptString(data, 'settledBy', 100)
        && isOptString(data, 'approvedBy', 100)
        && isOptString(data, 'approvedAt', 40)
        && isOptString(data, 'settlementNotes', 400)
        && isOptBool(data, 'isCorrectionAuthorized')
        && isOptString(data, 'correctionReason', 300)
        && isOptString(data, 'correctedBy', 100)
        && isOptString(data, 'correctedAt', 40)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidInvoice(data, companyId, invoiceId) {
      return data.keys().hasAll(['id', 'companyId', 'invoiceNumber', 'customerId', 'totalAmountPaise', 'status', 'issueDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'invoiceNumber', 'tripId', 'tripNumber', 'lrNumber',
          'customerId', 'customerName', 'customerGstin', 'billingAddress', 'originCity',
          'destinationCity', 'vehicleReg', 'goodsType', 'weightTonnes', 'ratePerTonnePaise',
          'hsnSacCode', 'issueDate', 'dueDate', 'freightAmountPaise', 'loadingChargesPaise',
          'unloadingChargesPaise', 'detentionChargesPaise', 'otherChargesPaise', 'discountPaise',
          'taxableAmountPaise', 'isRcmApplicable', 'gstRatePercent', 'cgstRatePercent',
          'sgstRatePercent', 'igstRatePercent', 'cgstAmountPaise', 'sgstAmountPaise',
          'igstAmountPaise', 'totalTaxPaise', 'totalAmountPaise', 'amountPaidPaise',
          'balanceDuePaise', 'status', 'paymentStatus', 'cancelledAt', 'cancellationReason',
          'notes', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.id == invoiceId
        && data.companyId == companyId
        && isReqString(data, 'invoiceNumber', 50)
        && isOptString(data, 'tripId', 128)
        && isOptString(data, 'tripNumber', 50)
        && isOptString(data, 'lrNumber', 50)
        && isReqString(data, 'customerId', 128)
        && isOptString(data, 'customerName', 150)
        && isOptString(data, 'customerGstin', 20)
        && isOptString(data, 'billingAddress', 300)
        && isOptString(data, 'originCity', 100)
        && isOptString(data, 'destinationCity', 100)
        && isOptString(data, 'vehicleReg', 30)
        && isOptString(data, 'goodsType', 120)
        && isOptNumber(data, 'weightTonnes')
        && isOptNumber(data, 'ratePerTonnePaise')
        && isOptString(data, 'hsnSacCode', 15)
        && isReqString(data, 'issueDate', 40)
        && isOptString(data, 'dueDate', 40)
        && isOptNumber(data, 'freightAmountPaise')
        && isOptNumber(data, 'loadingChargesPaise')
        && isOptNumber(data, 'unloadingChargesPaise')
        && isOptNumber(data, 'detentionChargesPaise')
        && isOptNumber(data, 'otherChargesPaise')
        && isOptNumber(data, 'discountPaise')
        && isOptNumber(data, 'taxableAmountPaise')
        && isOptBool(data, 'isRcmApplicable')
        && isOptNumber(data, 'gstRatePercent')
        && isOptNumber(data, 'cgstRatePercent')
        && isOptNumber(data, 'sgstRatePercent')
        && isOptNumber(data, 'igstRatePercent')
        && isOptNumber(data, 'cgstAmountPaise')
        && isOptNumber(data, 'sgstAmountPaise')
        && isOptNumber(data, 'igstAmountPaise')
        && isOptNumber(data, 'totalTaxPaise')
        && isReqNumber(data, 'totalAmountPaise') && data.totalAmountPaise >= 0
        && isOptNumber(data, 'amountPaidPaise')
        && isOptNumber(data, 'balanceDuePaise')
        && data.status is string
        && data.status in ['DRAFT', 'ISSUED', 'PARTIALLY_PAID', 'PAID', 'OVERDUE', 'CANCELLED']
        && (!('paymentStatus' in data) || data.paymentStatus == null || (data.paymentStatus is string && data.paymentStatus in ['UNPAID', 'PARTIALLY_PAID', 'PAID', 'OVERDUE', 'CANCELLED']))
        && isOptString(data, 'cancelledAt', 40)
        && isOptString(data, 'cancellationReason', 300)
        && isOptString(data, 'notes', 500)
        && isOptString(data, 'createdBy', 100)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidPayment(data, companyId, paymentId) {
      return data.keys().hasAll(['id', 'companyId', 'invoiceId', 'customerId', 'amountPaise', 'paymentDate', 'paymentMode', 'referenceNumber', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'invoiceId', 'invoiceNumber', 'customerId',
          'customerName', 'amountPaise', 'paymentDate', 'paymentMode',
          'referenceNumber', 'tdsDeductedPaise', 'bankAccount', 'recordedBy',
          'notes', 'createdAt', 'updatedAt'
        ])
        && data.id == paymentId
        && data.companyId == companyId
        && isReqString(data, 'invoiceId', 128)
        && isOptString(data, 'invoiceNumber', 50)
        && isReqString(data, 'customerId', 128)
        && isOptString(data, 'customerName', 150)
        && isReqNumber(data, 'amountPaise') && data.amountPaise > 0
        && isReqString(data, 'paymentDate', 40)
        && data.paymentMode is string
        && data.paymentMode in ['NEFT_RTGS', 'CHEQUE', 'UPI', 'CASH', 'BANK_TRANSFER']
        && isReqString(data, 'referenceNumber', 100)
        && isOptNumber(data, 'tdsDeductedPaise')
        && isOptString(data, 'bankAccount', 80)
        && isOptString(data, 'recordedBy', 100)
        && isOptString(data, 'notes', 400)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidVehicleDocument(data, companyId, docId) {
      return data.keys().hasAll(['id', 'companyId', 'vehicleId', 'docType', 'documentNumber', 'expiryDate', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'vehicleId', 'vehicleReg', 'docType', 'documentNumber',
          'issuingAuthority', 'issueDate', 'expiryDate', 'documentUrl',
          'daysUntilExpiry', 'status', 'createdAt', 'updatedAt'
        ])
        && data.id == docId
        && data.companyId == companyId
        && isReqString(data, 'vehicleId', 128)
        && isOptString(data, 'vehicleReg', 30)
        && data.docType is string
        && data.docType in ['RC', 'FITNESS', 'NATIONAL_PERMIT', 'STATE_PERMIT', 'INSURANCE', 'PUC', 'ROAD_TAX']
        && isReqString(data, 'documentNumber', 60)
        && isOptString(data, 'issuingAuthority', 120)
        && isOptString(data, 'issueDate', 40)
        && isReqString(data, 'expiryDate', 40)
        && isOptString(data, 'documentUrl', 1500)
        && isOptNumber(data, 'daysUntilExpiry')
        && data.status is string
        && data.status in ['VALID', 'EXPIRING_SOON', 'EXPIRED']
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidMaintenance(data, companyId, maintenanceId) {
      return data.keys().hasAll(['id', 'companyId', 'vehicleId', 'serviceType', 'costPaise', 'serviceDate', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'vehicleId', 'vehicleReg', 'serviceType', 'garageName',
          'costPaise', 'odometerReading', 'serviceDate', 'partsReplaced',
          'invoiceNumber', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.id == maintenanceId
        && data.companyId == companyId
        && isReqString(data, 'vehicleId', 128)
        && isOptString(data, 'vehicleReg', 30)
        && data.serviceType is string
        && data.serviceType in ['SCHEDULED_SERVICE', 'TYRE_REPLACEMENT', 'ENGINE_WORK', 'BRAKE_SUSPENSION', 'ACCIDENT_BREAKDOWN']
        && isOptString(data, 'garageName', 120)
        && isReqNumber(data, 'costPaise') && data.costPaise >= 0
        && isOptNumber(data, 'odometerReading')
        && isReqString(data, 'serviceDate', 40)
        && isOptString(data, 'partsReplaced', 300)
        && isOptString(data, 'invoiceNumber', 60)
        && isOptString(data, 'notes', 400)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidFileRecord(data, companyId, fileId) {
      return data.keys().hasAll(['id', 'companyId', 'uploadedByUid', 'folder', 'fileName', 'storagePath', 'downloadUrl', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'uploadedByUid', 'uploadedByName', 'folder', 'fileName',
          'mimeType', 'sizeBytes', 'storagePath', 'downloadUrl', 'entityType', 'entityId',
          'createdAt', 'updatedAt'
        ])
        && data.id == fileId
        && data.companyId == companyId
        && data.uploadedByUid == request.auth.uid
        && isOptString(data, 'uploadedByName', 100)
        && data.folder is string
        && data.folder in ['trips', 'dispatches', 'pod', 'expenses', 'fuel', 'documents', 'company']
        && isReqString(data, 'fileName', 200)
        && isOptString(data, 'mimeType', 100)
        && isOptNumber(data, 'sizeBytes')
        && isReqString(data, 'storagePath', 500)
        && isReqString(data, 'downloadUrl', 1500)
        && isOptString(data, 'entityType', 40)
        && isOptString(data, 'entityId', 128)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidCompanySettings(data, companyId, settingId) {
      return data.keys().hasAll(['id', 'companyId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'companyId', 'defaultGstRatePercent', 'defaultRcmEnabled',
          'defaultCreditPeriodDays', 'defaultFuelUnit', 'lowFastagThresholdPaise',
          'expiryAlertDays', 'autoGenerateLr', 'currency', 'updatedByUid',
          'createdAt', 'updatedAt'
        ])
        && data.id == settingId
        && data.companyId == companyId
        && isOptNumber(data, 'defaultGstRatePercent')
        && isOptBool(data, 'defaultRcmEnabled')
        && isOptNumber(data, 'defaultCreditPeriodDays')
        && (!('defaultFuelUnit' in data) || data.defaultFuelUnit == null || (data.defaultFuelUnit is string && data.defaultFuelUnit in ['LITRES', 'GALLONS']))
        && isOptNumber(data, 'lowFastagThresholdPaise')
        && isOptNumber(data, 'expiryAlertDays')
        && isOptBool(data, 'autoGenerateLr')
        && isOptString(data, 'currency', 10)
        && isOptString(data, 'updatedByUid', 128)
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function isValidAuditLog(data, companyId, logId) {
      return data.keys().hasAll(['id', 'companyId', 'userId', 'action', 'entityType', 'entityId', 'summary', 'timestamp'])
        && data.keys().hasOnly([
          'id', 'companyId', 'userId', 'userName', 'action', 'entityType',
          'entityId', 'moduleName', 'summary', 'previousValues', 'updatedValues', 'timestamp'
        ])
        && data.id == logId
        && data.companyId == companyId
        && data.userId == request.auth.uid
        && isOptString(data, 'userName', 100)
        && data.action is string
        && data.action in ['CREATE', 'UPDATE', 'DELETE', 'DISPATCH', 'SETTLE', 'APPROVE', 'INVOICE', 'PAYMENT', 'CANCEL']
        && data.entityType is string
        && data.entityType in [
          'TRIP', 'TRIP_LOG', 'DISPATCH', 'VEHICLE', 'DRIVER', 'ADVANCE', 'SETTLEMENT',
          'INVOICE', 'BILLING', 'PAYMENT', 'EXPENSE', 'FUEL', 'CUSTOMER',
          'BROKER', 'DOCUMENT', 'MAINTENANCE', 'FILE_RECORD', 'SETTINGS', 'COMPANY', 'MEMBER'
        ]
        && isReqString(data, 'entityId', 128)
        && isOptString(data, 'moduleName', 60)
        && isReqString(data, 'summary', 500)
        && (!('previousValues' in data) || (data.previousValues is map && data.previousValues.keys().size() <= 40))
        && (!('updatedValues' in data) || (data.updatedValues is map && data.updatedValues.keys().size() <= 40))
        && data.timestamp == request.time;
    }

    // ------------------------------------------------------------------------
    // 4. BOOT CONNECTION PING ENDPOINT
    // ------------------------------------------------------------------------
    match /test/{docId} {
      allow get: if docId == 'connection';
      allow list, write: if false;
    }

    // ------------------------------------------------------------------------
    // 5. USER PROFILES (/users/{userId}) - Strict Verified Owner & Anti-Escalation
    // ------------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedUser() && request.auth.uid == userId;
      allow list: if isVerifiedUser() && existing().id == request.auth.uid;
      allow create: if isValidId(userId)
                    && isVerifiedUser()
                    && request.auth.uid == userId
                    && isValidUser(incoming(), userId)
                    && (!('role' in incoming()) || incoming().role in ['USER', 'OWNER'])
                    && incoming().createdAt == request.time;
      allow update: if isValidId(userId)
                    && isVerifiedUser()
                    && request.auth.uid == userId
                    && isValidUser(incoming(), userId)
                    && isCreatedAtPreservedOrMigrated()
                    // Strict Owner-Only role preservation (no self-escalation)
                    && (
                      !('role' in existing())
                        ? (!('role' in incoming()) || incoming().role in ['USER', 'OWNER'])
                        : (
                          existing().role in ['USER', 'OWNER']
                            ? incoming().role == existing().role
                            : incoming().role == 'OWNER'
                        )
                    )
                    && (!('onboardingCompleted' in existing()) || existing().onboardingCompleted != true || incoming().onboardingCompleted == true)
                    && (
                      !('onboardingCompletedAt' in existing())
                      || !(existing().onboardingCompletedAt is string)
                      || (('onboardingCompletedAt' in incoming()) && incoming().onboardingCompletedAt == existing().onboardingCompletedAt)
                    )
                    && (
                      (
                        incoming().diff(existing()).addedKeys().hasOnly(['name', 'phone', 'defaultCompanyId', 'activeCompanyId', 'role', 'photoUrl', 'onboardingCompleted', 'onboardingCompletedAt', 'updatedAt'])
                        && incoming().diff(existing()).changedKeys().hasOnly(['name', 'phone', 'defaultCompanyId', 'activeCompanyId', 'role', 'photoUrl', 'onboardingCompleted', 'onboardingCompletedAt', 'updatedAt'])
                      ) ||
                      (
                        canMigrateLegacyCreatedAt()
                        && incoming().diff(existing()).addedKeys().hasOnly(['id', 'email', 'name', 'phone', 'defaultCompanyId', 'activeCompanyId', 'role', 'photoUrl', 'onboardingCompleted', 'onboardingCompletedAt', 'createdAt', 'updatedAt'])
                        && incoming().diff(existing()).changedKeys().hasOnly(['id', 'email', 'name', 'phone', 'defaultCompanyId', 'activeCompanyId', 'role', 'photoUrl', 'onboardingCompleted', 'onboardingCompletedAt', 'createdAt', 'updatedAt'])
                      )
                    );
      allow delete: if false;
    }

    // ------------------------------------------------------------------------
    // 6. MULTI-TENANT COMPANY ROOT (/companies/{companyId}) - Strict Owner-Only
    // ------------------------------------------------------------------------
    match /companies/{companyId} {
      // Allow verified null-resource check prior to creation or verified owner read
      allow get: if isValidId(companyId)
                 && isVerifiedUser()
                 && (resource == null || existing().ownerId == request.auth.uid);
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;

      allow create: if isValidId(companyId)
                    && isVerifiedUser()
                    && isValidCompany(incoming(), companyId)
                    && incoming().ownerId == request.auth.uid
                    && incoming().createdAt == request.time;

      allow update: if isValidId(companyId)
                    && isVerifiedUser()
                    && existing().ownerId == request.auth.uid
                    && isValidCompany(incoming(), companyId)
                    // Company ownership UID is strictly immutable
                    && incoming().ownerId == existing().ownerId
                    && isCreatedAtPreservedOrMigrated()
                    && (
                      (
                        incoming().diff(existing()).addedKeys().hasOnly([
                          'name', 'tradeName', 'gstin', 'pan', 'phone', 'email', 'address',
                          'city', 'state', 'stateCode', 'pincode', 'bankName', 'accountNumber',
                          'ifscCode', 'branch', 'lrPrefix', 'invoicePrefix', 'tripPrefix',
                          'fleetSize', 'logoUrl', 'updatedAt'
                        ]) &&
                        incoming().diff(existing()).changedKeys().hasOnly([
                          'name', 'tradeName', 'gstin', 'pan', 'phone', 'email', 'address',
                          'city', 'state', 'stateCode', 'pincode', 'bankName', 'accountNumber',
                          'ifscCode', 'branch', 'lrPrefix', 'invoicePrefix', 'tripPrefix',
                          'fleetSize', 'logoUrl', 'updatedAt'
                        ])
                      ) ||
                      (
                        canMigrateLegacyCreatedAt() &&
                        incoming().diff(existing()).addedKeys().hasOnly([
                          'id', 'name', 'tradeName', 'gstin', 'pan', 'phone', 'email', 'address',
                          'city', 'state', 'stateCode', 'pincode', 'bankName', 'accountNumber',
                          'ifscCode', 'branch', 'lrPrefix', 'invoicePrefix', 'tripPrefix',
                          'fleetSize', 'logoUrl', 'ownerId', 'createdAt', 'updatedAt'
                        ]) &&
                        incoming().diff(existing()).changedKeys().hasOnly([
                          'id', 'name', 'tradeName', 'gstin', 'pan', 'phone', 'email', 'address',
                          'city', 'state', 'stateCode', 'pincode', 'bankName', 'accountNumber',
                          'ifscCode', 'branch', 'lrPrefix', 'invoicePrefix', 'tripPrefix',
                          'fleetSize', 'logoUrl', 'ownerId', 'createdAt', 'updatedAt'
                        ])
                      )
                    );
      allow delete: if false;

      // ----------------------------------------------------------------------
      // 6.1 COMPANY OWNER RECORD (/companies/{companyId}/members/{memberUid})
      // Strictly limited to the company owner's own UID record (no employee/staff accounts)
      // ----------------------------------------------------------------------
      match /members/{memberUid} {
        allow get: if isValidId(companyId)
                   && isValidId(memberUid)
                   && isVerifiedUser()
                   && request.auth.uid == memberUid
                   && isCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(memberUid)
                      && isVerifiedUser()
                      && memberUid == request.auth.uid
                      && isValidMember(incoming(), companyId, memberUid)
                      && incoming().createdAt == request.time
                      && (
                        isCompanyOwner(companyId)
                        || getAfter(companyDocPath(companyId)).data.ownerId == request.auth.uid
                      );

        allow update: if isValidId(companyId)
                      && isValidId(memberUid)
                      && isVerifiedCompanyOwner(companyId)
                      && request.auth.uid == memberUid
                      && isValidMember(incoming(), companyId, memberUid)
                      && isCreatedAtPreservedOrMigrated()
                      && incoming().id == existing().id
                      && incoming().userId == existing().userId
                      && incoming().companyId == existing().companyId
                      && incoming().email == existing().email
                      && incoming().diff(existing()).addedKeys().hasOnly(['name', 'joinedAt', 'updatedAt'])
                      && incoming().diff(existing()).changedKeys().hasOnly(['name', 'joinedAt', 'updatedAt']);

        allow delete: if false;
      }

      // ----------------------------------------------------------------------
      // 6.2 FLEET VEHICLES (/companies/{companyId}/vehicles/{vehicleId})
      // ----------------------------------------------------------------------
      match /vehicles/{vehicleId} {
        allow get: if isValidId(companyId) && isValidId(vehicleId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(vehicleId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(vehicleId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(vehicleId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.3 DRIVERS (/companies/{companyId}/drivers/{driverId})
      // ----------------------------------------------------------------------
      match /drivers/{driverId} {
        allow get: if isValidId(companyId) && isValidId(driverId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(driverId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(driverId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(driverId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.4 CUSTOMERS (/companies/{companyId}/customers/{customerId})
      // ----------------------------------------------------------------------
      match /customers/{customerId} {
        allow get: if isValidId(companyId) && isValidId(customerId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(customerId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(customerId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(customerId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.4B BROKERS (/companies/{companyId}/brokers/{brokerId})
      // ----------------------------------------------------------------------
      match /brokers/{brokerId} {
        allow get: if isValidId(companyId) && isValidId(brokerId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(brokerId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(brokerId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(brokerId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.4C VENDORS (/companies/{companyId}/vendors/{vendorId})
      // ----------------------------------------------------------------------
      match /vendors/{vendorId} {
        allow get: if isValidId(companyId) && isValidId(vendorId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(vendorId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(vendorId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(vendorId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.5 TRIPS & DISPATCH (/companies/{companyId}/trips/{tripId})
      // Verified company owner has full control over Trips & Dispatch without
      // fixed schema, timestamp, or field allowlist restrictions.
      // ----------------------------------------------------------------------
      match /trips/{tripId} {
        allow get: if isValidId(companyId) && isValidId(tripId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(tripId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(tripId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(tripId) && isVerifiedCompanyOwner(companyId);

        // --------------------------------------------------------------------
        // 6.5B TRIP LOGS (/companies/{companyId}/trips/{tripId}/trip_logs/{logId})
        // --------------------------------------------------------------------
        match /trip_logs/{logId} {
          allow get: if isValidId(companyId) && isValidId(tripId) && isValidId(logId) && isVerifiedCompanyOwner(companyId);
          allow list: if isValidId(companyId) && isValidId(tripId) && isVerifiedCompanyOwner(companyId);

          allow create: if isValidId(companyId) && isValidId(tripId) && isValidId(logId)
                        && isValidTripLog(incoming(), companyId, tripId, logId)
                        && incoming().createdAt == request.time
                        && exists(/databases/$(database)/documents/companies/$(companyId)/trips/$(tripId))
                        && isVerifiedCompanyOwner(companyId);

          allow update: if isValidId(companyId) && isValidId(tripId) && isValidId(logId)
                        && isValidTripLog(incoming(), companyId, tripId, logId)
                        && isCreatedAtPreservedOrMigrated()
                        && (!('id' in existing()) || incoming().id == existing().id)
                        && incoming().companyId == existing().companyId
                        && incoming().tripId == existing().tripId
                        && isVerifiedCompanyOwner(companyId);

          allow delete: if isValidId(companyId) && isValidId(tripId) && isValidId(logId) && isVerifiedCompanyOwner(companyId);
        }
      }

      // ----------------------------------------------------------------------
      // 6.6 EXPENSES & FUEL (/companies/{companyId}/expenses/{expenseId})
      // ----------------------------------------------------------------------
      match /expenses/{expenseId} {
        allow get: if isValidId(companyId) && isValidId(expenseId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(expenseId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(expenseId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(expenseId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.7 DRIVER ADVANCES (/companies/{companyId}/advances/{advanceId})
      // ----------------------------------------------------------------------
      match /advances/{advanceId} {
        allow get: if isValidId(companyId) && isValidId(advanceId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(advanceId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(advanceId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(advanceId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.8 TRIP SETTLEMENTS (/companies/{companyId}/settlements/{settlementId})
      // ----------------------------------------------------------------------
      match /settlements/{settlementId} {
        allow get: if isValidId(companyId) && isValidId(settlementId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(settlementId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(settlementId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(settlementId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.9 BILLING & INVOICES (/companies/{companyId}/invoices/{invoiceId})
      // ----------------------------------------------------------------------
      match /invoices/{invoiceId} {
        allow get: if isValidId(companyId) && isValidId(invoiceId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(invoiceId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(invoiceId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(invoiceId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.10 PAYMENTS (/companies/{companyId}/payments/{paymentId})
      // ----------------------------------------------------------------------
      match /payments/{paymentId} {
        allow get: if isValidId(companyId) && isValidId(paymentId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(paymentId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(paymentId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(paymentId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.11 VEHICLE COMPLIANCE DOCUMENTS (/companies/{companyId}/documents/{docId})
      // ----------------------------------------------------------------------
      match /documents/{docId} {
        allow get: if isValidId(companyId) && isValidId(docId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(docId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(docId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(docId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.12 MAINTENANCE RECORDS (/companies/{companyId}/maintenance/{maintenanceId})
      // ----------------------------------------------------------------------
      match /maintenance/{maintenanceId} {
        allow get: if isValidId(companyId) && isValidId(maintenanceId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(maintenanceId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(maintenanceId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(maintenanceId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.13 UPLOADED FILE RECORDS (/companies/{companyId}/fileRecords/{fileId})
      // ----------------------------------------------------------------------
      match /fileRecords/{fileId} {
        allow get: if isValidId(companyId) && isValidId(fileId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(fileId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(fileId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(fileId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.14 COMPANY SETTINGS & PREFERENCES (/companies/{companyId}/settings/{settingId})
      // ----------------------------------------------------------------------
      match /settings/{settingId} {
        allow get: if isValidId(companyId) && isValidId(settingId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(settingId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update: if isValidId(companyId)
                      && isValidId(settingId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow delete: if isValidId(companyId) && isValidId(settingId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.15 AUDIT LOGS (/companies/{companyId}/auditLogs/{logId}) - Immutable
      // ----------------------------------------------------------------------
      match /auditLogs/{logId} {
        allow get: if isValidId(companyId) && isValidId(logId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId)
                      && isValidId(logId)
                      && isVerifiedCompanyOwner(companyId)
                      && (!('companyId' in incoming()) || incoming().companyId == companyId);

        allow update, delete: if false;
      }

      // ----------------------------------------------------------------------
      // 6.16 NOTIFICATIONS (/companies/{companyId}/notifications/{notificationId})
      // ----------------------------------------------------------------------
      match /notifications/{notificationId} {
        allow get: if isValidId(companyId) && isValidId(notificationId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId) && isValidId(notificationId)
                      && incoming().createdAt == request.time
                      && (!('companyId' in incoming()) || incoming().companyId == companyId)
                      && isVerifiedCompanyOwner(companyId);

        allow update: if isValidId(companyId) && isValidId(notificationId)
                      && isCreatedAtPreservedOrMigrated()
                      && (!('id' in existing()) || incoming().id == existing().id)
                      && (!('companyId' in incoming()) || incoming().companyId == existing().companyId)
                      && isVerifiedCompanyOwner(companyId);

        allow delete: if isValidId(companyId) && isValidId(notificationId) && isVerifiedCompanyOwner(companyId);
      }

      // ----------------------------------------------------------------------
      // 6.17 REPORTS (/companies/{companyId}/reports/{reportId})
      // ----------------------------------------------------------------------
      match /reports/{reportId} {
        allow get: if isValidId(companyId) && isValidId(reportId) && isVerifiedCompanyOwner(companyId);
        allow list: if isValidId(companyId) && isVerifiedCompanyOwner(companyId);

        allow create: if isValidId(companyId) && isValidId(reportId)
                      && incoming().createdAt == request.time
                      && (!('companyId' in incoming()) || incoming().companyId == companyId)
                      && isVerifiedCompanyOwner(companyId);

        allow update: if isValidId(companyId) && isValidId(reportId)
                      && isCreatedAtPreservedOrMigrated()
                      && (!('id' in existing()) || incoming().id == existing().id)
                      && (!('companyId' in incoming()) || incoming().companyId == existing().companyId)
                      && isVerifiedCompanyOwner(companyId);

        allow delete: if isValidId(companyId) && isValidId(reportId) && isVerifiedCompanyOwner(companyId);
      }
    }
  }
}
