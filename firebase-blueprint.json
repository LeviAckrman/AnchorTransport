{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile in AnchorTransport TMS",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Unique Firebase user ID (matches request.auth.uid)" },
        "email": { "type": "string", "format": "email", "maxLength": 200, "description": "User email address" },
        "name": { "type": "string", "maxLength": 100, "description": "Full name of user" },
        "phone": { "type": "string", "maxLength": 20, "description": "Contact phone number" },
        "defaultCompanyId": { "type": "string", "maxLength": 128, "description": "Default active company UUID" },
        "activeCompanyId": { "type": "string", "maxLength": 128, "description": "Currently active company UUID" },
        "role": { "type": "string", "enum": ["OWNER", "ADMIN", "MANAGER", "ACCOUNTANT", "OPERATIONS"] },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "name", "createdAt", "updatedAt"]
    },
    "Company": {
      "title": "Company",
      "description": "Transport business company record (fleet owner)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "description": "Company UUID" },
        "name": { "type": "string", "maxLength": 150, "description": "Registered company legal name" },
        "tradeName": { "type": "string", "maxLength": 150, "description": "Trade name" },
        "gstin": { "type": "string", "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$", "maxLength": 15 },
        "pan": { "type": "string", "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$", "maxLength": 10 },
        "phone": { "type": "string", "maxLength": 25 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 80 },
        "state": { "type": "string", "maxLength": 60 },
        "stateCode": { "type": "string", "maxLength": 5 },
        "pincode": { "type": "string", "maxLength": 10 },
        "bankName": { "type": "string", "maxLength": 100 },
        "accountNumber": { "type": "string", "maxLength": 40 },
        "ifscCode": { "type": "string", "maxLength": 15 },
        "branch": { "type": "string", "maxLength": 100 },
        "lrPrefix": { "type": "string", "maxLength": 30 },
        "invoicePrefix": { "type": "string", "maxLength": 30 },
        "tripPrefix": { "type": "string", "maxLength": 30 },
        "fleetSize": { "type": "string", "maxLength": 50 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "ownerId": { "type": "string", "maxLength": 128, "description": "User ID of the fleet business owner" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId", "createdAt", "updatedAt"]
    },
    "CompanyMember": {
      "title": "CompanyMember",
