rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Default deny across the entire bucket
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedOwner(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && isValidSegment(userId)
        && ('email_verified' in request.auth.token)
        && request.auth.token.email_verified == true;
    }

    function isValidSegment(val) {
      return val is string && val.size() > 0 && val.size() <= 128 && val.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Strict < 20 MB upload cap (and non-empty)
    function isUnderMaxFileSize() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size < 20 * 1024 * 1024;
    }

    // Allowed MIME types: Images (JPG/JPEG, PNG, WebP, GIF - excludes SVG to prevent XSS),
    // PDF, Word (DOC/DOCX), Excel (XLS/XLSX), and CSV
    function isAllowedContentType() {
      return request.resource != null
        && request.resource.contentType != null
        && request.resource.contentType in [
          'image/jpeg',
          'image/jpg',
          'image/png',
          'image/webp',
          'image/gif',
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'text/csv'
        ];
    }

    // Prevent spoofed uploadedBy customMetadata if provided
    function isValidUploadMetadata() {
      return request.resource.metadata == null
        || !('uploadedBy' in request.resource.metadata)
        || request.resource.metadata.uploadedBy == request.auth.uid;
    }

    // Strict UID-isolated private user storage:
    // users/{userId}/{category}/{fileName}
    // (including users/{userId}/trips/journal_{journalTripId}/{fileName})
    match /users/{userId}/{allPaths=**} {
      allow read, delete: if isVerifiedOwner(userId);

      allow create, update: if isVerifiedOwner(userId)
                            && isUnderMaxFileSize()
                            && isAllowedContentType()
                            && isValidUploadMetadata();
    }
  }
}
