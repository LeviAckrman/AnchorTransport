rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn()
        && ('email_verified' in request.auth.token)
        && request.auth.token.email_verified == true;
    }

    function isValidSegment(val) {
      return val is string && val.size() > 0 && val.size() <= 128 && val.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function companyDocPath(companyId) {
      return /databases/ai-studio-anchortransportt-c5041a54-7d47-45d6-a1f6-5144adf1df5d/documents/companies/$(companyId);
    }

    function isVerifiedCompanyOwner(companyId) {
      return isVerifiedUser()
        && isValidSegment(companyId)
        && firestore.exists(companyDocPath(companyId))
        && firestore.get(companyDocPath(companyId)).data.ownerId == request.auth.uid;
    }

    function isAllowedFolder(folder) {
      return folder in ['trips', 'dispatches', 'pod', 'expenses', 'fuel', 'documents', 'company'];
    }

    function isImageOrPdf() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }

    function isUnderMaxSize(maxMegabytes) {
      return request.resource.size <= maxMegabytes * 1024 * 1024;
    }

    // Company-scoped compliance documents (RC, Insurance, PUC, Permit, POD, LR, Dispatch, Fuel, Expense)
    match /companies/{companyId}/{folder}/{fileName} {
      // Strictly only the verified company owner can read its files
      allow read: if isVerifiedCompanyOwner(companyId) && isAllowedFolder(folder);

      // Uploads must verify company ownership, file type, 15MB cap, and matching customMetadata
      allow create, update: if isVerifiedCompanyOwner(companyId)
                            && isAllowedFolder(folder)
                            && isImageOrPdf()
                            && isUnderMaxSize(15)
                            && request.resource.metadata != null
                            && request.resource.metadata.companyId == companyId
                            && request.resource.metadata.uploadedByUid == request.auth.uid;

      // Strictly only the verified company owner can delete its files
      allow delete: if isVerifiedCompanyOwner(companyId) && isAllowedFolder(folder);
    }
  }
}
